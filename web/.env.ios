# iOS アプリの既定の接続先（Cloudflare にデプロイした本番）。
# 接続先はアプリのログイン画面・設定画面からいつでも切り替えられる（ビルドし直し不要）。
VITE_API_BASE=https://i-vocabulary.inai17ibar.workers.dev/api/v1

# アプリ内で選べる候補。`名前=URL;名前=URL`（URL はパス省略で /api/v1 を補う）。
# 自宅の LAN IP など個人の値は .env.ios.local（git 管理外）に書く（このファイルの値を上書きするので、こちらの候補も含めること）。
VITE_API_SERVERS=このMac（シミュレーター）=localhost:8787
